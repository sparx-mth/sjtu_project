# ============================================================
# room_docker/Dockerfile.jetson
# ROS2 Humble container for the room_search task on a Jetson AGX
# (Orin, JetPack 6.x). x86_64 builds use the sibling Dockerfile;
# `run_room_search.sh` picks the right one automatically per
# `uname -m`.
#
# Base: dustynv's official ROS2 Humble + PyTorch image for L4T.
# Saves us a full Jetson-specific PyTorch wheel install (which is
# tied to the JetPack version and has no pip presence) and ships a
# CUDA/cuDNN toolchain that matches the on-board L4T runtime. See
# https://github.com/dusty-nv/jetson-containers for the build matrix.
#
# Override the base for a different JetPack:
#   docker build --build-arg BASE_IMAGE=dustynv/ros:humble-pytorch-l4t-r35.4.1 \
#                -f Dockerfile.jetson -t room_search:humble-jetson .
# r36.* tracks JetPack 6.x (Ubuntu 22.04, native Humble — Jetson AGX Orin).
# r35.* tracks JetPack 5.x (Ubuntu 20.04 — Jetson AGX Xavier; Humble runs
# but is not the L4T native distro for that JetPack — expect rough edges).
#
# What this image deliberately does NOT install (vs the x86 Dockerfile):
#   * ompl       (no aarch64 pip wheel; room_search doesn't use it)
#   * scikit-image, scipy   (used by path_planner_node + voronoi; room_search doesn't launch those)
#   * openai-clip            (heavy; not used by yolo_detector / object_mapper / target_watcher)
#   * openai     (the python sdk; target_watcher uses requests for both ollama + openai-compat)
#   * transforms3d (not used by the 3 semantic_mapper nodes this launch runs)
#
# Add any of these back if you extend the launch with more semantic_mapper
# nodes, but for the "nav + spin + visual close-in + land" pipeline they
# are dead weight on a constrained device.
# ============================================================
ARG BASE_IMAGE=dustynv/ros:humble-pytorch-l4t-r36.4.0
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# ── ROS2 message + bridge packages ──────────────────────────
# vision_msgs is what /perception/detections rides on; cv_bridge is
# needed by semantic_mapper/yolo_detector + object_mapper_node for
# Image <-> numpy conversion; rmw-cyclonedds-cpp matches the
# perception_docker DDS choice so the two containers can talk on the
# same domain without a QoS surprise.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-vision-msgs \
        ros-humble-cv-bridge \
        ros-humble-image-transport \
        ros-humble-rmw-cyclonedds-cpp \
        python3-colcon-common-extensions \
        python3-pip \
        git \
    && rm -rf /var/lib/apt/lists/*

# ── Python deps ────────────────────────────────────────────
# IMPORTANT: do NOT reinstall torch / torchvision / numpy here.
# The dustynv base image already ships builds matched to the L4T
# CUDA runtime; pulling in a fresh wheel will downgrade them to a
# CPU-only build (PyPI has no Jetson CUDA wheels) and YOLO will then
# silently run on the ARM cores at ~1/30th the speed.
#
# `ultralytics` is the only heavy install. We pin to the same version
# the x86 Dockerfile pins, and pass --no-deps + an explicit allow-list
# so its requirements file doesn't drag in a CPU-only torch.
RUN pip install --no-cache-dir --no-deps \
        "ultralytics==8.3.0" \
    && pip install --no-cache-dir \
        "PyYAML>=5.3" \
        "tqdm>=4.64.0" \
        "pandas>=1.1.4" \
        "seaborn>=0.11.0" \
        "matplotlib>=3.3" \
        "psutil" \
        "py-cpuinfo" \
        "requests>=2.23.0"
# (opencv-python is intentionally omitted — cv_bridge above brings
# the system OpenCV with matching ABI, and the apt python3-opencv
# binding is already on the base image.)

# Sanity check: torch + ultralytics import on the *Jetson* runtime.
# We can't test .cuda.is_available() at build time (no GPU in
# buildkit), but a clean import catches the classic "torch was
# replaced with a CPU wheel" regression early.
RUN python3 -c "import torch; print('torch', torch.__version__, 'CUDA build:', torch.version.cuda)"
RUN python3 -c "from ultralytics import YOLOWorld; print('ultralytics + YOLO-World import OK')"

# ── Workspace ───────────────────────────────────────────────
RUN mkdir -p /ros2_ws/src
WORKDIR /ros2_ws

COPY cyclonedds.xml /etc/cyclonedds.xml
ENV CYCLONEDDS_URI=file:///etc/cyclonedds.xml

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
