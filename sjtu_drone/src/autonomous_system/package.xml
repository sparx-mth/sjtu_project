<?xml version="1.0"?>
<package format="3">
  <name>autonomous_system</name>
  <version>0.1.0</version>
  <description>Autonomous multi-agent navigation and control framework for a drone.</description>

  <maintainer email="you@example.com">Nadav</maintainer>
  <license>MIT</license>

  <!-- Build system for mixed C++/Python packages with interfaces -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- For generating services -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- C++ dependencies -->
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>

  <!-- OMPL (C++) -->
  <build_depend>libompl-dev</build_depend>
  <exec_depend>libompl-dev</exec_depend>

  <!-- OpenCV + yaml-cpp (C++) -->
  <build_depend>libopencv-dev</build_depend>
  <exec_depend>libopencv-dev</exec_depend>
  <build_depend>yaml-cpp</build_depend>
  <exec_depend>yaml-cpp</exec_depend>

  <!-- Python + ROS dependencies -->
  <exec_depend>rclpy</exec_depend>

  <!-- Map loading + CV for Python -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>