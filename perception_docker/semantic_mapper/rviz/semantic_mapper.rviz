Panels:
  - Class: rviz_common/Displays
    Name: Displays
    SplitterRatio: 0.5
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 28; 30; 38
    Fixed Frame: world
    Frame Rate: 20

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera

  Displays:

    # ── Reference grid ──
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 60
      Cell Size: 1
      Color: 55; 58; 68
      Line Style: 0
      Reference Frame: world

    # ── BEV occupancy from FALCON's voxel map ──
    - Class: rviz_default_plugins/Map
      Name: BEV
      Topic:
        Value: /falcon/bev_2d
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.35
      Draw Behind: true
      Enabled: true

    # ── Scene-graph markers (rooms + doors + edges) ──
    - Class: rviz_default_plugins/MarkerArray
      Name: SceneGraph
      Topic:
        Value: /scene_graph/markers
        Reliability Policy: Reliable
      Enabled: true
      Namespaces:
        room_fill:            true
        skeleton:             true
        rooms:                true
        room_labels:          true
        doors_discovered:     true
        doors_pending:        true
        door_labels:          true
        door_labels_pending:  true
        cut_disks:            true
        room_room_edges:      true

    # ── Detected objects on the map + legend ──
    # obj:<class>   coloured cell patch (one namespace per class)
    # obj_labels    small class tag hovering over each object
    # legend        "OBJECTS" header + "<class> xN" rows in map corner
    # legend_sw     colour swatch next to each legend row
    - Class: rviz_default_plugins/MarkerArray
      Name: Objects
      Topic:
        Value: /perception/object_markers
        Reliability Policy: Reliable
      Enabled: true

  # ── Top-down orthographic, framed for the hospital map ──
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Target Frame: world
      X: 0
      Y: -8.5
      Angle: 0
      Scale: 18
      Invert Z Axis: false
      Near Clip Distance: 0.01
    Saved:
      - Class: rviz_default_plugins/Orbit
        Name: Orbit3D
        Target Frame: world
        Distance: 70
        Pitch: 0.95
        Yaw: 0.79
        Focal Point: { X: 0, Y: -8.5, Z: 0 }

Window Geometry:
  Width: 1600
  Height: 1000
  Displays:
    collapsed: false
  Hide Left Dock: false
  Hide Right Dock: false