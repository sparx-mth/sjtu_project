Panels:
  - Class: rviz_common/Displays
    Name: Displays
    SplitterRatio: 0.5
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 28; 30; 38
    Fixed Frame: world
    Frame Rate: 20

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera

  Displays:

    # ── Grid: subtle reference ──
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 60
      Cell Size: 1
      Color: 55; 58; 68
      Line Style: 0
      Reference Frame: world

    # ── BEV occupancy from drone depth ──
    # Unknown cells are grey, free white, occupied black. Drawn behind
    # the scene graph so the colored room fills sit clearly on top.
    - Class: rviz_default_plugins/Map
      Name: BEV
      Topic:
        Value: /scene_graph/bev
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.35
      Draw Behind: true
      Enabled: true

    # ── Scene graph markers from simple_mapper ──
    #
    # Namespaces (in publishing order):
    #   room_fill         — translucent colored cells, one color per room
    #   rooms             — small sphere at each room's centroid (graph node)
    #   room_labels       — "R0 (123 cells)" floating above each room
    #   doors_pending     — FAINT GREY cylinders: known doors not yet reached
    #   doors_discovered  — BRIGHT ORANGE cylinders: doors the drone has seen
    #   door_labels       — "d0", "d12" captions above each door
    #   room_room_edges   — yellow lines connecting rooms through discovered
    #                       doors — this is the scene-graph topology
    - Class: rviz_default_plugins/MarkerArray
      Name: SceneGraph
      Topic:
        Value: /scene_graph/markers
        Reliability Policy: Reliable
      Enabled: true
      Namespaces:
        room_fill:         true
        rooms:             true
        room_labels:       true
        doors_pending:     true
        doors_discovered:  true
        door_labels:       true
        room_room_edges:   true

  # ── Camera: top-down orthographic, framed for the hospital map ──
  # Map spans roughly x=[-9..9], y=[-32..15]. Centre the view at its
  # midpoint and pick a scale that fits the long axis comfortably.
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Target Frame: world
      X: 0
      Y: -8.5
      Angle: 0
      Scale: 18    # ≈ pixels per metre; shows ~55 m vertically at 1000 px
      Invert Z Axis: false
      Near Clip Distance: 0.01
    Saved:
      - Class: rviz_default_plugins/Orbit
        Name: Orbit3D
        Target Frame: world
        Distance: 70
        Pitch: 0.95
        Yaw: 0.79
        Focal Point: { X: 0, Y: -8.5, Z: 0 }

Window Geometry:
  Width: 1600
  Height: 1000
  Displays:
    collapsed: false
  Hide Left Dock: false
  Hide Right Dock: false