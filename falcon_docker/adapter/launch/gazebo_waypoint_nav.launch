<launch>
  <!--
    gazebo_waypoint_nav.launch  (v7 — camera intrinsics as args)
    ════════════════════════════════════════════════════════════════════
    v7 vs v5:
      - Camera intrinsics are now <arg>s (cam_fx, cam_fy, cam_cx, cam_cy,
        cam_width, cam_height, cam_min_depth, cam_max_depth). Defaults
        are the xtend drone K-matrix values for the 504x392 stream.
        Override from real_drone.launch or the command line per camera.

    v5 vs v4:
      - Added `bridge_camera_info` arg (default false). sensor_gate
        will neither subscribe to camera_info nor republish it. FALCON
        reads camera intrinsics from rosparam below, so the topic was
        redundant. Set to true to restore the v4 behaviour.

    v4 vs v3:
      - Added `pose_topic`, `depth_topic`, `camera_info_topic` args.
      - sensor_gate receives those topic names via private params.
  -->

  <!-- ══════════════════════════════════════════════════════════════
       USER-FACING ARGS
       ══════════════════════════════════════════════════════════════ -->
  <arg name="map_name" default="hospital" />
  <arg name="drone_ns" default="/simple_drone" />
  <arg name="gated_ns" default="/gated_drone" />

  <!-- v4: input topic overrides. Defaults preserve the v3 sjtu_drone
       layout, so leaving these unset gives identical Gazebo behaviour. -->
  <arg name="pose_topic"
       default="$(arg drone_ns)/gt_pose" />
  <arg name="depth_topic"
       default="$(arg drone_ns)/front_depth/depth/image_raw" />
  <arg name="camera_info_topic"
       default="$(arg drone_ns)/front_depth/depth/camera_info" />

  <!-- v5: when false, sensor_gate ignores camera_info entirely. -->
  <arg name="bridge_camera_info" default="false" />

  <!-- Camera intrinsics — loaded from a camera_calibration_parsers
       YAML (camera_config_file) when set; the cam_* args below act as
       both the literal fallback (when camera_config_file:='') and the
       CLI override path (`roslaunch ... cam_fx:=...`).

       Source is the YAML's `projection_matrix.data` (the rectified
       3x4 P matrix), NOT camera_matrix.data. Reason: after image
       rectification and crop, the principal point and effective focal
       length live in the upper-left 3x3 block of P; K still describes
       the unrectified raw sensor. Falcon consumes the rectified
       stream, so it needs P-derived intrinsics.

       P is a 12-element row-major array. The mapping is:
         fx = P[0]   cx = P[2]
         fy = P[5]   cy = P[6]
       The rest of P encodes the (zero here) stereo baseline and the
       0/0/0/1 homogeneous row, which we ignore for monocular use.

       Fallback literals match projection_matrix.data from
       config/camera_xtend_ros_calib_504_392_crop_resize.yaml.
       MUST match the actual depth stream — if image_width /
       image_height don't match, frames are silently dropped. -->
  <arg name="camera_config_file"
       default="$(find falcon_adapter)/config/camera_xtend_ros_calib_504_392_crop_resize.yaml"
       doc="Path to a camera_calibration_parsers YAML. Empty disables YAML loading." />
<!--   <arg name="cam_fx"        default="390.715302" /> -->
<!--   <arg name="cam_fy"        default="395.828430" /> -->
<!--   <arg name="cam_cx"        default="222.273390" /> -->
<!--   <arg name="cam_cy"        default="108.547631" /> -->
<!--   <arg name="cam_width"     default="504" /> -->
<!--   <arg name="cam_height"    default="392" /> -->
<!--   <arg name="cam_min_depth" default="0.1" /> -->
<!--   <arg name="cam_max_depth" default="10.0" /> -->
  <arg name="cam_fx"        default="361.52381185798737" />
  <arg name="cam_fy"        default="410.764442594862" />
  <arg name="cam_cx"        default="341.3434895805878" />
  <arg name="cam_cy"        default="116.76308616209292" />
  <arg name="cam_width"     default="728" />
  <arg name="cam_height"    default="420" />
  <arg name="cam_min_depth" default="0.1" />
  <arg name="cam_max_depth" default="10.0" />

  <!-- Goal -->
  <arg name="goal_x" default="4.0" />
  <arg name="goal_y" default="0.0" />

  <!-- Speeds & radii -->
  <arg name="vel_x"                  default="0.3" />
  <arg name="yaw_rate"               default="0.7" />
  <arg name="pos_acquisition_radius" default="0.3" />
  <arg name="yaw_acquisition_radius" default="0.2" />
  <arg name="yaw_lead_pct"           default="10.0" />

  <!-- A* / path -->
  <arg name="waypoint_spacing_m"    default="1.5" />
  <arg name="inflate_radius_m"      default="0.1" />
  <arg name="unknown_blocked"       default="false" />
  <arg name="unknown_cost"          default="1.0" />
  <arg name="los_smoothing"         default="true" />
  <arg name="turn_penalty"          default="0.0" />
  <arg name="replan_on_collision"   default="true" />
  <arg name="replan_on_bev"         default="false" />
  <arg name="replan_period_s"       default="0.0" />

  <!-- Takeoff & cruise -->
  <arg name="auto_takeoff"      default="false" />
  <arg name="cruise_z"          default="1.0" />
  <arg name="freeze_during_yaw" default="true" />
  <arg name="maintain_altitude" default="true" />
  <arg name="use_posctrl"       default="true" />
  <arg name="ctrl_rate_hz"      default="5.0" />

  <arg name="forward_only"      default="true" />
  <arg name="cmd_log_path"      default="/home/nadavc/Desktop/cmd_log_{ts}.jsonl" />

  <!-- BEV -->
  <arg name="bev_resolution"  default="0.15" />
  <arg name="bev_xmin"        default="-12.0" />
  <arg name="bev_ymin"        default="-12.0" />
  <arg name="bev_xmax"        default="12.0" />
  <arg name="bev_ymax"        default="12.0" />
  <arg name="bev_z_min"       default="0.30" />
  <arg name="bev_z_max"       default="1.80" />
  <arg name="bev_publish_hz"  default="2.0" />
  <arg name="bev_occ_dilate"  default="0" />

  <!-- FALCON speed / safety / frontier -->
  <arg name="max_vel"     default="0.25" />
  <arg name="max_acc"     default="0.25" />
  <arg name="max_yaw_vel" default="0.6" />
  <arg name="max_yaw_acc" default="0.5" />

  <arg name="obstacles_inflation"        default="0.85" />
  <arg name="safe_distance"              default="0.85" />
  <arg name="frontier_min_clearance"     default="0.50" />
  <arg name="frontier_min_occ_clearance" default="0.75" />
  <arg name="frontier_candidate_rmin"    default="1.0" />
  <arg name="frontier_candidate_rmax"    default="5.5" />

  <arg name="fsm_replan_thresh1"   default="2.0" />
  <arg name="fsm_replan_thresh2"   default="2.0" />
  <arg name="fsm_replan_thresh3"   default="2.0" />
  <arg name="fsm_replan_time"      default="60.0" />
  <arg name="fsm_thresh_replan"    default="60.0" />
  <arg name="fsm_thresh_no_replan" default="60.0" />

  <!-- ══════════════════════════════════════════════════════════════
       LOAD FALCON CONFIG
       ══════════════════════════════════════════════════════════════ -->
  <rosparam command="load" file="$(find exploration_manager)/config/robot/uav_model_simulator.yaml"/>
  <rosparam command="load" file="$(find exploration_manager)/config/map/$(arg map_name).yaml"/>
  <rosparam command="load" file="$(find voxel_mapping)/config/voxel_mapping.yaml"/>
  <rosparam command="load" file="$(find pathfinding)/config/astar.yaml"/>
  <rosparam command="load" file="$(find fast_planner)/config/fast_planner.yaml"/>
  <rosparam command="load" file="$(find exploration_preprocessing)/config/frontier_finder.yaml"/>
  <rosparam command="load" file="$(find exploration_preprocessing)/config/hgrid.yaml"/>
  <rosparam command="load" file="$(find exploration_utils)/config/perception_utils.yaml"/>
  <rosparam command="load" file="$(find exploration_manager)/config/exploration_manager.yaml"/>

  <!-- Camera intrinsics: the cam_* args are now fully resolved
       (either from the YAML's camera_matrix.data via $(eval) above,
       or from literal fallbacks / CLI overrides), so a flat
       arg-to-param mapping is all that's needed here. -->
  <param name="/uav_model/sensing_parameters/camera_intrinsics/fx" value="$(arg cam_fx)" />
  <param name="/uav_model/sensing_parameters/camera_intrinsics/fy" value="$(arg cam_fy)" />
  <param name="/uav_model/sensing_parameters/camera_intrinsics/cx" value="$(arg cam_cx)" />
  <param name="/uav_model/sensing_parameters/camera_intrinsics/cy" value="$(arg cam_cy)" />
  <param name="/uav_model/sensing_parameters/image_width"  value="$(arg cam_width)" />
  <param name="/uav_model/sensing_parameters/image_height" value="$(arg cam_height)" />
  <param name="/uav_model/sensing_parameters/min_depth"    value="$(arg cam_min_depth)" />
  <param name="/uav_model/sensing_parameters/max_depth"    value="$(arg cam_max_depth)" />

  <!-- Transformer -->
  <param name="/transformer/pose_topic_type"     value="pose" />
  <param name="/transformer/timestamp_tolerance" value="0.05" />

  <!-- Speed limits -->
  <param name="/uav_model/dynamics_parameters/max_linear_velocity"     value="$(arg max_vel)" />
  <param name="/uav_model/dynamics_parameters/max_linear_acceleration" value="$(arg max_acc)" />
  <param name="/uav_model/dynamics_parameters/max_yaw_velocity"        value="$(arg max_yaw_vel)" />
  <param name="/uav_model/dynamics_parameters/max_yaw_acceleration"    value="$(arg max_yaw_acc)" />

  <param name="/voxel_mapping/obstacles_inflation" value="$(arg obstacles_inflation)" />
  <param name="/bspline_opt/safe_distance"         value="$(arg safe_distance)" />

  <param name="/frontier_finder/min_candidate_clearance"          value="$(arg frontier_min_clearance)" />
  <param name="/frontier_finder/min_candidate_occupied_clearance" value="$(arg frontier_min_occ_clearance)" />
  <param name="/frontier_finder/candidate_rmin"                   value="$(arg frontier_candidate_rmin)" />
  <param name="/frontier_finder/candidate_rmax"                   value="$(arg frontier_candidate_rmax)" />

  <param name="/fsm/replan_thresh1"   value="$(arg fsm_replan_thresh1)" />
  <param name="/fsm/replan_thresh2"   value="$(arg fsm_replan_thresh2)" />
  <param name="/fsm/replan_thresh3"   value="$(arg fsm_replan_thresh3)" />
  <param name="/fsm/replan_time"      value="$(arg fsm_replan_time)" />
  <param name="/fsm/thresh_replan"    value="$(arg fsm_thresh_replan)" />
  <param name="/fsm/thresh_no_replan" value="$(arg fsm_thresh_no_replan)" />

  <param name="/traj_server/init_dx" value="0.0" />
  <param name="/traj_server/init_dy" value="0.0" />
  <param name="/traj_server/init_dz" value="0.0" />

  <!-- ══════════════════════════════════════════════════════════════
       NODES
       ══════════════════════════════════════════════════════════════ -->

  <node pkg="falcon_adapter" type="sensor_gate.py"
        name="sensor_gate" output="screen">
    <param name="in_ns"              value="$(arg drone_ns)" />
    <param name="out_ns"             value="$(arg gated_ns)" />
    <param name="pose_topic"         value="$(arg pose_topic)" />
    <param name="depth_topic"        value="$(arg depth_topic)" />
    <param name="camera_info_topic"  value="$(arg camera_info_topic)" />
    <param name="bridge_camera_info" value="$(arg bridge_camera_info)" />
    <param name="replay_hz"          value="30.0" />
  </node>

  <node pkg="falcon_adapter" type="falcon_adapter.py"
        name="falcon_adapter" output="screen">
    <param name="drone_ns"     value="$(arg gated_ns)" />
    <param name="world_frame"  value="world" />
    <param name="body_frame"   value="body" />
    <param name="cam_frame"    value="camera" />
    <param name="cam_offset_x" value="0.2" />
    <param name="odom_min_dt"  value="0.04" />
    <param name="depth_min_dt" value="0.04" />
  </node>

  <node pkg="exploration_manager" name="exploration_node" type="exploration_node"
        output="screen" respawn="false">
    <remap from="/odom_world"                    to="/odom_world"/>
    <remap from="/voxel_mapping/depth_image"     to="/map_ros/depth"/>
    <remap from="/transformer/sensor_pose_topic" to="/map_ros/pose"/>
  </node>

  <node pkg="falcon_adapter" type="bev_publisher.py"
        name="bev_publisher" output="screen">
    <param name="frame_id"         value="world" />
    <param name="resolution"       value="$(arg bev_resolution)" />
    <param name="bbox_xmin"        value="$(arg bev_xmin)" />
    <param name="bbox_ymin"        value="$(arg bev_ymin)" />
    <param name="bbox_xmax"        value="$(arg bev_xmax)" />
    <param name="bbox_ymax"        value="$(arg bev_ymax)" />
    <param name="z_slab_min"       value="$(arg bev_z_min)" />
    <param name="z_slab_max"       value="$(arg bev_z_max)" />
    <param name="publish_hz"       value="$(arg bev_publish_hz)" />
    <param name="occ_dilate_cells" value="$(arg bev_occ_dilate)" />
    <param name="out_topic"        value="/falcon/bev_2d" />
    <param name="occ_topic"        value="/voxel_mapping/occupancy_grid_occupied" />
    <param name="free_topic"       value="/voxel_mapping/occupancy_grid_free" />
  </node>

  <node pkg="falcon_adapter" type="astar_planner.py"
        name="astar_planner" output="screen">
    <param name="drone_ns"           value="$(arg drone_ns)" />
    <param name="bev_topic"          value="/falcon/bev_2d" />
    <param name="path_topic"         value="/path/waypoints" />
    <param name="goal_topic"         value="/waypoint_nav/goal" />
    <param name="goal_x"             value="$(arg goal_x)" />
    <param name="goal_y"             value="$(arg goal_y)" />
    <param name="waypoint_spacing_m" value="$(arg waypoint_spacing_m)" />
    <param name="inflate_radius_m"      value="$(arg inflate_radius_m)" />
    <param name="unknown_blocked"       value="$(arg unknown_blocked)" />
    <param name="unknown_cost"          value="$(arg unknown_cost)" />
    <param name="los_smoothing"         value="$(arg los_smoothing)" />
    <param name="turn_penalty"          value="$(arg turn_penalty)" />
    <param name="replan_on_collision"   value="$(arg replan_on_collision)" />
    <param name="replan_on_bev"         value="$(arg replan_on_bev)" />
    <param name="replan_period_s"       value="$(arg replan_period_s)" />
    <param name="frame_id"              value="world" />
  </node>

  <node pkg="falcon_adapter" type="waypoint_follower.py"
        name="waypoint_follower" output="screen">
    <param name="drone_ns"               value="$(arg drone_ns)" />
    <param name="vel_x"                  value="$(arg vel_x)" />
    <param name="yaw_rate"               value="$(arg yaw_rate)" />
    <param name="pos_acquisition_radius" value="$(arg pos_acquisition_radius)" />
    <param name="yaw_acquisition_radius" value="$(arg yaw_acquisition_radius)" />
    <param name="yaw_lead_pct"           value="$(arg yaw_lead_pct)" />
    <param name="auto_takeoff"           value="$(arg auto_takeoff)" />
    <param name="cruise_z"               value="$(arg cruise_z)" />
    <param name="use_posctrl"            value="$(arg use_posctrl)" />
    <param name="freeze_during_yaw"      value="$(arg freeze_during_yaw)" />
    <param name="maintain_altitude"      value="$(arg maintain_altitude)" />
    <param name="ctrl_rate_hz"           value="$(arg ctrl_rate_hz)" />
    <param name="forward_only"           value="$(arg forward_only)" />
    <param name="cmd_log_path"           value="$(arg cmd_log_path)" />
  </node>

  <node pkg="falcon_adapter" type="voxel_reset_watcher.py"
        name="voxel_reset_watcher" output="screen">
    <param name="topic"     value="/voxel_mapping/occupancy_grid_occupied" />
    <param name="drop_frac" value="0.5" />
    <param name="min_prev"  value="500" />
    <param name="print_hz"  value="0.5" />
  </node>

  <node pkg="odom_visualization" name="odom_visualization"
        type="odom_visualization" output="screen">
    <remap from="~odometry" to="/odom_world"/>
  </node>

</launch>